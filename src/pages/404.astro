---
import Layout from '@/layouts/Layout.astro'
---

<Layout>
  <div class="uno-decorative-line"></div>
  <h3 class="not-found-heading">
    <span>PAGE</span>
    <span>NOT</span>
    <span>FOUND</span>
  </h3>
  <p class="not-found-text">
    <span>It looks like the page you're looking for</span>
    <span>does not exist or has been moved.</span>
  </p>
</Layout>

<style>
.not-found-heading {
  margin-top: -0.325rem;
  display: flex;
  flex-direction: column;
  font-size: 2rem;
  color: var(--color-primary);
  font-weight: 700;
  line-height: 1.2em;
  font-family: var(--font-navbar);
}
@media (min-width: 1024px) {
  .not-found-heading { font-size: 2.25rem; }
}

.not-found-text {
  margin-top: 0.9rem;
  display: flex;
  flex-direction: column;
  font-size: 0.9rem;
  line-height: 1.4em;
  font-family: var(--font-navbar);
}
@media (min-width: 1024px) {
  .not-found-text { margin-top: 1rem; font-size: 1rem; }
}
</style>
