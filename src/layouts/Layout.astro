---
import type { MarkdownHeading } from 'astro'
import Footer from '@/components/Footer.astro'
import Anim from '../components/Anim.jsx';
import Navbar from '@/components/Navbar.astro'
import CodeCopyButton from '@/components/Widgets/CodeCopyButton.astro'
import GithubCard from '@/components/Widgets/GithubCard.astro'
import GsapAnimation from '@/components/Widgets/GsapAnimation.astro'
import PhotoSwipe from '@/components/Widgets/PhotoSwipe.astro'
import SoundEffect from '@/components/Widgets/SoundEffect.astro'
import TOC from '@/components/Widgets/TOC.astro'
import themeConfig from '@/config'
import Head from '@/layouts/Head.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/theme.css'
import '@/styles/extend.css'
import '@/styles/font.css'
import '@/styles/global.css'
import '@/styles/lqip.css'
import '@/styles/markdown.css'
import '@/styles/transition.css'
import '@/styles/anim.css'

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
  postAbbrlink?: string
  headings?: MarkdownHeading[]
}

const { postTitle, postDescription, postSlug, postAbbrlink, headings } = Astro.props
const { isPost, isAbout, isHome, isTag } = getPageInfo(Astro.url.pathname)
const isAnimPost = postAbbrlink === 'anim'
const fontStyle = themeConfig.global.fontStyle === 'serif' ? 'font-serif' : 'font-sans'
const animationEnabled = !themeConfig.global.reduceMotion
const mainClass = isPost && themeConfig.comment?.enabled ? 'main-with-comments' : 'main-no-comments'
const showTOCSidebar = isPost && !isAnimPost && !isAbout
---

<html
  lang="en"
  class:list={[
    fontStyle,
    { 'scroll-smooth': isPost },
  ]}
>
  <Head {postTitle} {postDescription} {postSlug} />
  <body>
    <div id="noise-overlay" transition:persist></div>
    <canvas id="twinkle-overlay" transition:persist></canvas>
    <div class="page-wrapper">
      {showTOCSidebar
        ? <div class="toc-sidebar-wrapper"><TOC headings={headings ?? []} sidebar={true} /></div>
        : <Anim client:load isAbout={isAbout} />
      }
      <Navbar />
      <main class={mainClass}>
        <slot />
      </main>
      <Footer />
    </div>
    {animationEnabled && <GsapAnimation />}
    <SoundEffect />
    <CodeCopyButton />
    <PhotoSwipe />
    <GithubCard />
  </body>
</html>

<script>
  // Twinkling dot lattice over the dark background. One fixed full-viewport canvas
  // (persisted across view transitions); each dot fades on its own slow sine at ~18fps.
  // Skips entirely in light mode and paints a single static frame under reduced motion.
  const cv = document.getElementById('twinkle-overlay') as HTMLCanvasElement | null
  if (cv) {
    const ctx = cv.getContext('2d')!
    const PITCH = 30
    const RH = PITCH * 0.8660254
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    let dots: number[] = []
    let cw = 0
    let ch = 0
    let last = -1e9
    let painted = false

    function lay(w: number, h: number) {
      dots = []
      for (let r = 0, y = -RH; y < h + RH; r++, y += RH) {
        const ox = r & 1 ? PITCH / 2 : 0
        for (let x = ox - PITCH; x < w + PITCH; x += PITCH)
          dots.push(x, y, Math.random() * 6.2832, 0.45 + Math.random() * 1.05)
      }
    }

    function draw(now: number, animate: boolean) {
      const w = innerWidth
      const h = innerHeight
      const dpr = Math.min(devicePixelRatio || 1, 2)
      if (cv!.width !== ((w * dpr) | 0) || cv!.height !== ((h * dpr) | 0)) {
        cv!.width = w * dpr
        cv!.height = h * dpr
        cw = 0
      }
      if (w !== cw || h !== ch) {
        lay(w, h)
        cw = w
        ch = h
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, w, h)
      ctx.fillStyle = 'rgb(230,228,218)'
      const t = now * 0.001
      for (let i = 0; i < dots.length; i += 4) {
        ctx.globalAlpha = animate
          ? 0.075 * (0.5 + 0.5 * Math.sin(t * dots[i + 3] + dots[i + 2]))
          : 0.045
        ctx.fillRect(dots[i] - 1, dots[i + 1] - 1, 2, 2)
      }
      ctx.globalAlpha = 1
    }

    function frame(now: number) {
      requestAnimationFrame(frame)
      if (!document.documentElement.classList.contains('dark')) {
        painted = false
        return
      }
      if (reduce) {
        if (!painted) {
          draw(now, false)
          painted = true
        }
        return
      }
      if (now - last < 55) return
      last = now
      draw(now, true)
    }

    addEventListener('resize', () => { painted = false }, { passive: true })
    requestAnimationFrame(frame)
  }
</script>

<style>
.page-wrapper {
  position: relative;
  margin-left: auto;
  margin-right: auto;
  max-width: 51.462rem;
  min-height: 100vh;
  min-height: 100dvh;
  width: 100%;
  padding: 2.5rem min(7.25vw, 3.731rem);
}
@media (min-width: 1024px) {
  .page-wrapper {
    margin-left: max(5.75rem, calc(50vw - 34.25rem));
    margin-right: max(5.75rem, calc(50vw - 34.25rem));
    margin-top: 5rem;
    margin-bottom: 5rem;
    max-width: min(calc(75vw - 16rem), 44rem);
    min-height: 100%;
    padding: 0;
  }
}
.main-with-comments { margin-bottom: 2.5rem; }
.main-no-comments { margin-bottom: 3rem; }
</style>
