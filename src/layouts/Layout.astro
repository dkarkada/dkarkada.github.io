---
import type { MarkdownHeading } from 'astro'
import Footer from '@/components/Footer.astro'
import Anim from '../components/Anim.jsx';
import Navbar from '@/components/Navbar.astro'
import CodeCopyButton from '@/components/Widgets/CodeCopyButton.astro'
import GithubCard from '@/components/Widgets/GithubCard.astro'
import GsapAnimation from '@/components/Widgets/GsapAnimation.astro'
import PhotoSwipe from '@/components/Widgets/PhotoSwipe.astro'
import SoundEffect from '@/components/Widgets/SoundEffect.astro'
import TOC from '@/components/Widgets/TOC.astro'
import themeConfig from '@/config'
import Head from '@/layouts/Head.astro'
import { getPageInfo } from '@/utils/page'
import '@/styles/theme.css'
import '@/styles/extend.css'
import '@/styles/font.css'
import '@/styles/global.css'
import '@/styles/lqip.css'
import '@/styles/markdown.css'
import '@/styles/transition.css'
import '@/styles/anim.css'

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
  postAbbrlink?: string
  headings?: MarkdownHeading[]
}

const { postTitle, postDescription, postSlug, postAbbrlink, headings } = Astro.props
const { isPost, isAbout, isHome, isTag } = getPageInfo(Astro.url.pathname)
const isAnimPost = postAbbrlink === 'anim'
const fontStyle = themeConfig.global.fontStyle === 'serif' ? 'font-serif' : 'font-sans'
const animationEnabled = !themeConfig.global.reduceMotion
const mainClass = isPost && themeConfig.comment?.enabled ? 'main-with-comments' : 'main-no-comments'
const showTOCSidebar = isPost && !isAnimPost && !isAbout
---

<html
  lang="en"
  class:list={[
    fontStyle,
    { 'scroll-smooth': isPost },
  ]}
>
  <Head {postTitle} {postDescription} {postSlug} />
  <body>
    <div id="noise-overlay" transition:persist="noise-overlay"></div>
    <div id="grain-shimmer" transition:persist="grain-shimmer" aria-hidden="true"></div>
    <div class="page-wrapper">
      {showTOCSidebar
        ? <div class="toc-sidebar-wrapper"><TOC headings={headings ?? []} sidebar={true} /></div>
        : <Anim client:load isAbout={isAbout} />
      }
      <Navbar />
      <main class={mainClass}>
        <slot />
      </main>
      <Footer />
    </div>
    {animationEnabled && <GsapAnimation />}
    <SoundEffect />
    <CodeCopyButton />
    <PhotoSwipe />
    <GithubCard />
  </body>
</html>

<script>
  // Dark-mode background grain. Twelve greyscale noise layers around a ring,
  // scanned by a moving raised-cosine window: the layers within the window
  // composite as a running-normalised `over` stack, so the group is a convex
  // combination of mean-0.5 fields. Blended `overlay` once (see #grain-shimmer
  // in global.css), that leaves the ground's mean lightness untouched at every
  // phase — only the fine grain morphs. Skips work in light mode; paints a
  // single static frame under reduced motion.
  //
  // `color-interpolation-filters='sRGB'` below is load-bearing, not decoration.
  // The SVG default is linearRGB, so feTurbulence's mean-0.5 field would be
  // generated and processed in linear space and then converted to sRGB for
  // display, landing at mean 0.73 rather than 0.5. On a dark ground `overlay`
  // reduces to 2·base·blend — linear in the blend value — so that turned the
  // whole page ~1.46× lighter the moment the layers mounted, which read as a
  // flash. With sRGB interpolation the tile is genuinely mean-0.5 and the
  // blend is an exact no-op on the ground, so there is nothing to flash.
  //
  // Cost notes: the fractalNoise filter is rasterised ONCE — all 12 layers
  // share the same data-URI (the browser decodes it a single time) and merely
  // sample it at 12 well-separated `background-position` offsets, which read as
  // 12 decorrelated fields. `#grain-shimmer` is transition:persist'd; the
  // script is deduped across client-side navigations, so the build + rAF loop
  // are re-attached on every `astro:page-load` — keeping the persisted layers
  // if they survived, rebuilding them if not.
  const N = 12           // layers around the ring
  const PERIOD = 3       // seconds for one full trip round the ring
  const HALF = 2.5       // window half-width, in layers (~5 layers overlap)
  const TILE = 170
  // Grain frequency is breakpoint-dependent: narrow viewports get a finer
  // tile, at the same 1024px breakpoint the layout already uses. Evaluated
  // when the tile is built rather than live — setup() rebuilds if the viewport
  // has since crossed the breakpoint. Both frequencies are mean-0.5, so the
  // no-flash property above holds either way (sd 16.5 vs 15.8 — no retune).
  const WIDE = '(min-width: 1024px)'
  const baseFreq = () => matchMedia(WIDE).matches ? 0.5 : 0.6
  const OCTAVES = 3
  // Contrast, scaled about a fixed 0.5 midpoint. Retuned from 2.5 alongside
  // the sRGB fix: sRGB interpolation raises the tile's sd on its own, and the
  // ground it multiplies is now ~1.46× lighter, so matching the old visible
  // grain needs a *lower* slope. 1.2 puts the tile at sd ≈ 16.5, which after
  // the brighter ground reproduces the previous sd ≈ 23.6 at the pixel.
  const SLOPE = 1.2
  const BLUR = 1.0       // feGaussianBlur stdDeviation, softens the hash
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  const noiseURI = () => {
    const icpt = (0.5 - 0.5 * SLOPE).toFixed(4)
    const svg
      = "<svg xmlns='http://www.w3.org/2000/svg' width='" + TILE + "' height='" + TILE + "'>"
      + "<filter id='n' color-interpolation-filters='sRGB'>"
      + "<feTurbulence type='fractalNoise' baseFrequency='" + baseFreq()
      + "' numOctaves='" + OCTAVES + "' seed='7' stitchTiles='stitch'/>"
      + "<feColorMatrix type='saturate' values='0'/>"
      + "<feComponentTransfer>"
      + "<feFuncR type='linear' slope='" + SLOPE + "' intercept='" + icpt + "'/>"
      + "<feFuncG type='linear' slope='" + SLOPE + "' intercept='" + icpt + "'/>"
      + "<feFuncB type='linear' slope='" + SLOPE + "' intercept='" + icpt + "'/>"
      + "<feFuncA type='linear' slope='0' intercept='1'/>"
      + "</feComponentTransfer>"
      + "<feGaussianBlur stdDeviation='" + BLUR + "' edgeMode='wrap'/>"
      + "</filter>"
      + "<rect width='100%' height='100%' filter='url(#n)'/></svg>"
    return 'data:image/svg+xml,' + encodeURIComponent(svg)
  }

  let layers: HTMLElement[] = []
  let phase = 0
  let last = -1
  let painted = false
  let looping = false

  function apply(p: number) {
    if (!layers.length) return
    const w: number[] = []
    for (let i = 0; i < N; i++) {
      let d = Math.abs(i - p)
      d = Math.min(d, N - d)
      const c = d < HALF ? Math.cos((Math.PI / 2) * (d / HALF)) : 0
      w.push(c * c)
    }
    // running-normalised `over` stack -> group = sum(w_i N_i) / sum(w_i)
    let cum = 0
    for (let i = 0; i < N; i++) {
      cum += w[i]
      layers[i].style.opacity = cum > 1e-6 ? String(w[i] / cum) : '0'
    }
  }

  function frame(now: number) {
    requestAnimationFrame(frame)
    if (!document.documentElement.classList.contains('dark')) {
      painted = false
      return
    }
    if (reduce) {
      if (!painted) {
        apply(0)
        painted = true
      }
      return
    }
    if (now - last < 33) return           // ~30fps is plenty for a slow morph
    const dt = last < 0 ? 0 : (now - last) / 1000
    last = now
    phase = (phase + (dt / PERIOD) * N) % N
    apply(phase)
    painted = true
  }

  function setup() {
    const root = document.getElementById('grain-shimmer')
    if (!root) return
    // The persisted layers record the breakpoint they were rasterised at. If
    // the viewport has crossed it since (rotation, a resized window), drop
    // them so the tile is rebuilt at the right frequency.
    const bp = matchMedia(WIDE).matches ? 'wide' : 'narrow'
    if (root.dataset.bp !== bp) {
      root.replaceChildren()
      root.dataset.bp = bp
    }
    if (!root.querySelector('.grain-layer')) {
      const bg = 'url("' + noiseURI() + '")'   // one tile, decoded once, shared by all
      const size = TILE + 'px ' + TILE + 'px'
      const frag = document.createDocumentFragment()
      for (let i = 0; i < N; i++) {
        // golden-ratio low-discrepancy offsets: consecutive layers land far
        // apart, so a window of neighbours reads as decorrelated fields
        // crossfading (morphing), not one field sliding.
        const ox = ((i * 0.6180339887) % 1) * TILE
        const oy = ((i * 0.4142135624) % 1) * TILE
        const d = document.createElement('div')
        d.className = 'grain-layer'
        d.style.backgroundImage = bg
        d.style.backgroundSize = size
        d.style.backgroundPosition = ox.toFixed(1) + 'px ' + oy.toFixed(1) + 'px'
        frag.appendChild(d)
      }
      root.appendChild(frag)
    }
    layers = Array.from(root.querySelectorAll('.grain-layer')) as HTMLElement[]
    last = -1
    painted = false
    if (!looping) {
      looping = true
      requestAnimationFrame(frame)
    }
  }

  setup()
  document.addEventListener('astro:page-load', setup)
</script>

<style>
.page-wrapper {
  position: relative;
  margin-left: auto;
  margin-right: auto;
  max-width: 51.462rem;
  min-height: 100vh;
  min-height: 100dvh;
  width: 100%;
  padding: 2.5rem min(7.25vw, 3.731rem);
}
@media (min-width: 1024px) {
  .page-wrapper {
    margin-left: max(5.75rem, calc(50vw - 34.25rem));
    margin-right: max(5.75rem, calc(50vw - 34.25rem));
    margin-top: 5rem;
    margin-bottom: 5rem;
    max-width: min(calc(75vw - 16rem), 44rem);
    min-height: 100%;
    padding: 0;
  }
}
.main-with-comments { margin-bottom: 2.5rem; }
.main-no-comments { margin-bottom: 3rem; }
</style>
