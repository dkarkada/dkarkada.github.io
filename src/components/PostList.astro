---
import type { CollectionEntry } from 'astro:content'
import PinIcon from '@/assets/icons/pin-icon.svg'
import PostDate from '@/components/PostDate.astro'
import { defaultLocale } from '@/config'
import { generateDescription } from '@/utils/description'
import { isHomePage } from '@/utils/page'

type Post = CollectionEntry<'posts'> & {
  remarkPluginFrontmatter: {
    minutes: number
  }
}

const { posts, lang, pinned = false } = Astro.props
const isHome = isHomePage(Astro.url.pathname)

export interface Props {
  posts: Post[]
  lang: string
  pinned?: boolean
}

function getPostPath(post: Post) {
  const postPath = post.data.abbrlink || post.id
  if (lang === defaultLocale) return `/posts/${postPath}/`
  return `/${lang}/posts/${postPath}/`
}
---

<ul>
  {posts.map(post => (
    <li class:list={['post-item', { 'home-item': isHome }]}>

      {/* post title; the pin (if any) sits directly against the link, with no
          whitespace between them, so its negative margin alone sets the offset.
          The link's ::after stretches over the whole item (title, description,
          date), so all three lines are one click target. */}
      <h3 class="post-title-wrapper">
        {pinned && <PinIcon aria-hidden="true" class="pin-icon" fill="currentColor" />}<a class:list={['post-link', { 'home-link': isHome }]} href={getPostPath(post)} transition:name={`post-${post.data.abbrlink || post.id}${lang ? `-${lang}` : ''}`} data-disable-theme-transition>{post.data.title}</a>
      </h3>

      {/* post description (home page) */}
      {isHome && <p class="post-desc">{generateDescription(post, 'list')}</p>}

      {/* post date and reading time */}
      {post.data.showdate && (
        <div
          class="post-time"
          transition:name={`time-${post.data.abbrlink || post.id}${lang ? `-${lang}` : ''}`}
          data-disable-theme-transition
        >
          <PostDate
            date={post.data.published}
            minutes={post.remarkPluginFrontmatter.minutes}
          />
        </div>
      )}

    </li>
  ))}
</ul>

<style>
/* Each item is a single click target sized to its three lines: title,
   description, then date and reading time. */
.post-item {
  position: relative;
  width: fit-content;
  max-width: 100%;
  margin-bottom: 1.375rem;
}
@media (min-width: 1024px) {
  .post-item.home-item { margin-bottom: 2.5rem; }
}

.post-title-wrapper {
  display: inline;
  transition: color 150ms cubic-bezier(0, 0, 0.2, 1);
}

/* Desktop only. The pin hangs in the left margin: a negative left margin
   equal to its width plus the gap cancels its advance, so pinned titles start
   on the same edge as every other title. */
.pin-icon {
  --pin-size: 1.05em;
  --pin-gap: 0.5em;
  display: none;
  aspect-ratio: 1 / 1;
  width: var(--pin-size);
  margin-left: calc(-1 * (var(--pin-size) + var(--pin-gap)));
  margin-right: var(--pin-gap);
  transform: translateY(-0.15em);
}
@media (min-width: 1024px) {
  .pin-icon { display: inline-block; }
}

.post-link {
  font-size: 1.375rem;
  font-family: var(--font-serif);
}
/* mobile home listing runs smaller than the tag listings */
.post-link.home-link { font-size: 1.1rem; }
@media (min-width: 1024px) {
  .post-link.home-link { font-weight: 500; font-size: 1.125rem; }
}
.post-link::after {
  content: '';
  position: absolute;
  inset: 0;
}
.post-link:focus-visible { outline: none; }
.post-link:focus-visible::after {
  outline: 1px solid oklch(var(--color-text-params) / 0.5);
  outline-offset: 0.35rem;
  border-radius: 0.25rem;
}

/* Description and date share one look: Spectral 400 italic at 60% ink. The
   weight is fixed, independent of the reader's Heavy/Regular choice (and
   Spectral, since EB Garamond, the theme's time font, reads much lighter).
   Their opacity makes them stacking contexts that paint over the link's
   stretched ::after (which can't be raised: the link's view-transition-name
   confines its z-index), so clicks fall through them to the link. */
.post-desc,
.post-time {
  font-family: var(--font-serif);
  font-size: 0.9rem;
  line-height: 1.2rem;
  font-style: italic;
  font-weight: 400;
  text-wrap: pretty;
  opacity: 0.6;
  pointer-events: none;
  transition: opacity 150ms cubic-bezier(0, 0, 0.2, 1);
}
@media (min-width: 1024px) {
  .post-desc,
  .post-time {
    font-size: 1rem;
    line-height: 1.25rem;
  }
}
.post-time { margin-top: 0.1rem; }

/* Hover (or keyboard focus): brighten all three lines together */
.post-item:is(:hover, :focus-within) .post-title-wrapper { color: var(--color-emphasis); }
.post-item:is(:hover, :focus-within) :is(.post-desc, .post-time) { opacity: 0.85; }
</style>
