---
import type { CollectionEntry } from 'astro:content'
import PinIcon from '@/assets/icons/pin-icon.svg'
import PostDate from '@/components/PostDate.astro'
import { defaultLocale } from '@/config'
import { generateDescription } from '@/utils/description'
import { isHomePage } from '@/utils/page'

type Post = CollectionEntry<'posts'> & {
  remarkPluginFrontmatter: {
    minutes: number
  }
}

const { posts, lang, pinned = false } = Astro.props
const isHome = isHomePage(Astro.url.pathname)

export interface Props {
  posts: Post[]
  lang: string
  pinned?: boolean
}

function getPostPath(post: Post) {
  const postPath = post.data.abbrlink || post.id
  if (lang === defaultLocale) return `/posts/${postPath}/`
  return `/${lang}/posts/${postPath}/`
}
---

<ul>
  {posts.map(post => (
    <li class:list={['post-item', { 'home-item': isHome }]}>

      {/* post title */}
      <h3 class="post-title-wrapper">

        {/* pinned icon */}
        {pinned && (
          <PinIcon
            aria-hidden="true"
            class="pin-icon"
            fill="currentColor"
          />
        )}

        <a
          class:list={['post-link', { 'home-link': isHome }]}
          href={getPostPath(post)}
          transition:name={`post-${post.data.abbrlink || post.id}${lang ? `-${lang}` : ''}`}
          data-disable-theme-transition
        >
          {post.data.title}
        </a>
      </h3>

      {/* mobile post time */}
      {post.data.showdate && (
        <div
          class="post-time-mobile"
          transition:name={`time-${post.data.abbrlink || post.id}${lang ? `-${lang}` : ''}`}
          data-disable-theme-transition
        >
          <PostDate
            date={post.data.published}
            minutes={post.remarkPluginFrontmatter.minutes}
          />
        </div>
      )}

      {/* desktop post time */}
      {post.data.showdate && (
        <div class="post-time-desktop">
          <PostDate
            date={post.data.published}
            minutes={post.remarkPluginFrontmatter.minutes}
          />
        </div>
      )}

      {/* desktop post description */}
      {isHome && (
        <div class="post-desc heti">
          <p class="post-desc-text">{generateDescription(post, 'list')}</p>
        </div>
      )}

    </li>
  ))}
</ul>

<style>
.post-item { margin-bottom: 1.375rem; }
@media (min-width: 1024px) {
  .post-item.home-item { margin-bottom: 2.5rem; }
}

.post-title-wrapper {
  display: inline;
  transition-property: color;
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
  transition-duration: 150ms;
}
.post-title-wrapper:hover { color: var(--color-primary); }

.pin-icon {
  margin-right: 0.5em;
  display: inline-block;
  aspect-ratio: 1 / 1;
  width: 0.98em;
  transform: translateY(-0.1em);
}
@media (min-width: 1024px) {
  .pin-icon { width: 1.05em; transform: translateY(-0.15em); }
}

.post-link {
  font-size: 1.375rem;
  font-family: var(--font-serif);
}
@media (min-width: 1024px) {
  .post-link.home-link { font-weight: 500; font-size: 1.125rem; }
}

.post-time-mobile {
  padding-top: 0.2rem;
  padding-bottom: 0.2rem;
  font-size: 0.875rem;
  font-family: var(--font-time);
}
@media (min-width: 1024px) {
  .post-time-mobile { display: none; }
}

.post-time-desktop {
  display: none;
  font-size: 1rem;
  font-family: var(--font-time);
}
@media (min-width: 1024px) {
  .post-time-desktop { display: inline; margin-left: 0.625rem; }
}

.post-desc { display: none; }
@media (min-width: 1024px) {
  .post-desc { display: block; }
}

.post-desc-text {
  font-size: 1rem !important;
  line-height: 1.25rem !important;
  font-style: italic;
  opacity: 0.6;
}
</style>
