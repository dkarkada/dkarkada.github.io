---
import { defaultLocale, themeConfig } from '@/config'

const walineLocaleMap = {'en': "en-US"}
const {
  waline: {
    serverURL = '',
    emoji = [],
    search = false,
    imageUploader = false,
  } = {},
} = themeConfig.comment ?? {}
---

<div id="waline" style="margin-top: 4rem;"></div>

<script
  is:inline
  define:vars={{
    serverURL,
    emoji,
    search,
    imageUploader,
    walineLocaleMap,
    defaultLocale,
  }}
  type="module"
>
import { init } from '/vendors/waline/waline.js'

function setupWaline() {
  const currentPath = window.location.pathname
  const pathLang = Object.keys(walineLocaleMap).find(code =>
    currentPath.startsWith(`/${code}/`),
  )
  const lang = pathLang ?? defaultLocale
  const currentWalineLang = walineLocaleMap[lang]

  init({
    el: '#waline',
    serverURL,
    path: window.location.pathname.replace(/^\/([a-z]{2}(-[a-z]{2})?)\//, '/'),
    lang: currentWalineLang,
    emoji,
    dark: 'html.dark',
    requiredMeta: ['nick', 'mail'],
    highlighter: false,
    texRenderer: false,
    imageUploader,
    search,
    noCopyright: true,
    reaction: [],
  })
}

function lazySetupWaline() {
  const walineContainer = document.getElementById('waline')
  if (!walineContainer) return

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        setupWaline()
        observer.unobserve(entry.target)
      }
    })
  }, { rootMargin: '200px' })

  observer.observe(walineContainer)
}

lazySetupWaline()
document.addEventListener('astro:page-load', lazySetupWaline)
</script>

<style is:global>
#waline .wl-login-info {
  margin-right: 0.75rem;
  margin-top: 0;
}
#waline .wl-avatar {
  border: none;
}
#waline .wl-logout-btn {
  z-index: 99;
}
#waline .wl-login-nick:not(:has(img)) {
  margin-top: 0.35rem;
  line-height: 0.9rem;
}
#waline .wl-panel {
  margin: 0;
  border-color: oklch(var(--color-secondary-params) / 0.25);
  border-radius: 0.5rem;
  background-color: transparent;
}
#waline .wl-header {
  padding: 0;
}
#waline .wl-header-item {
  border-bottom-width: 1px;
  border-bottom-color: oklch(var(--color-primary-params) / 0.25);
  border-style: solid;
}
#waline .wl-header label {
  font-size: 0.75rem;
}
#waline .wl-header input {
  font-size: 0.7rem;
}
#waline .wl-card,
#waline .wl-header.item3 {
  border-bottom-width: 0;
}
#waline .wl-card .wl-quote {
  margin-top: 1rem;
  border-inline-start: none;
}
#waline .wl-editor {
  min-height: 6rem;
}
#waline .wl-editor::placeholder {
  color: oklch(var(--color-primary-params) / 0.25);
}
#waline .wl-footer {
  margin: 0.5rem;
}
#waline .wl-text-number,
#waline .wl-action[title="Markdown Guide"],
#waline .wl-sort,
#waline .wl-gallery::-webkit-scrollbar {
  display: none;
}
#waline .wl-emoji-popup {
  inset-inline-start: 0;
  max-width: 532px;
  border-color: oklch(var(--color-secondary-params) / 0.25);
}
#waline .wl-emoji-popup .wl-tab-wrapper {
  scrollbar-width: thin;
}
#waline .wl-gif-popup {
  border-color: oklch(var(--color-secondary-params) / 0.25);
}
#waline .wl-gif-popup input {
  border-color: oklch(var(--color-secondary-params) / 0.25);
  background-color: var(--color-background);
}
#waline .wl-gif-popup input::placeholder {
  font-size: 0.875rem;
  color: oklch(var(--color-secondary-params) / 0.3);
}
#waline .wl-gallery {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
#waline .wl-gallery::-webkit-scrollbar {
  display: none;
}
#waline .wl-meta-head {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0.5rem;
  padding-top: 0.75rem;
}
#waline .wl-card-item {
  padding-left: 0;
  padding-right: 0;
}
#waline .wl-user-avatar {
  margin-top: 0.25rem;
}
#waline .wl-content p {
  font-size: 0.875rem;
  line-height: 1.5rem;
}
#waline .wl-time {
  color: oklch(var(--color-primary-params) / 0.75);
}
#waline .wl-edit,
#waline .wl-delete {
  margin-right: 0.1rem;
}
#waline .wl-like {
  margin-right: 0.3rem;
}
</style>

<style>
#waline {
  --waline-white: var(--color-background);
  --waline-light-grey: oklch(var(--color-primary-params) / 0.25);
  --waline-dark-grey: var(--color-secondary);
  --waline-theme-color: var(--color-primary);
  --waline-active-color: var(--color-primary);
  --waline-color: var(--color-secondary);
  --waline-bg-color: var(--color-background);
  --waline-bg-color-light: var(--color-background);
  --waline-bg-color-hover: var(--color-background);
  --waline-border-color: oklch(var(--color-primary-params) / 0.25);
  --waline-disable-bg-color: oklch(var(--color-secondary-params) / 0.05);
  --waline-disable-color: var(--color-primary);
  --waline-bq-color: oklch(var(--color-primary-params) / 0.25);
  --waline-info-bg-color: var(--color-background);
  --waline-info-color: oklch(var(--color-primary-params) / 0.25);
  --waline-avatar-radius: 0.5rem;
}
</style>
