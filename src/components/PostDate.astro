---
import { themeConfig } from '@/config'
import { isPostPage } from '@/utils/page'

interface Props {
  date: Date
  updatedDate?: Date
  minutes: number
}

const { date, updatedDate, minutes } = Astro.props
const format = themeConfig.global.dateFormat
const isPost = isPostPage(Astro.url.pathname)
const spacingClass = isPost ? 'post-spacing' : 'list-spacing'

function formatDate(date: Date, format: 'YYYY-MM-DD' | 'MM-DD-YYYY' | 'DD-MM-YYYY' | 'MONTH DAY YYYY' | 'DAY MONTH YYYY') {
  const date_shifted = new Date(date.getTime() + 12*60*60*1000);
  if (format === 'YYYY-MM-DD') {
    return date_shifted.toISOString().split('T')[0]
  }

  const options: Intl.DateTimeFormatOptions = {
    year: 'numeric',
    month: format === 'MONTH DAY YYYY' || format === 'DAY MONTH YYYY' ? 'short' : '2-digit',
    day: format === 'MONTH DAY YYYY' || format === 'DAY MONTH YYYY' ? 'numeric' : '2-digit',
  }

  switch (format) {
    case 'MM-DD-YYYY':
      return date_shifted.toLocaleDateString('en-US', options).replace(/\//g, '-')
    case 'DD-MM-YYYY':
      return date_shifted.toLocaleDateString('en-GB', options).replace(/\//g, '-')
    case 'MONTH DAY YYYY':
      return date_shifted.toLocaleDateString('en-US', {
        year: 'numeric', month: 'short', day: 'numeric',
      }).replace(',', '')
    case 'DAY MONTH YYYY':
      return date_shifted.toLocaleDateString('en-GB', {
        year: 'numeric', month: 'short', day: 'numeric',
      }).replace(',', '')
    default:
      return date_shifted.toISOString().split('T')[0]
  }
}
---

<time datetime={date.toISOString().split('T')[0]}>
  {formatDate(date, format)}
</time>

{updatedDate && (
  <time
    datetime={updatedDate.toISOString().split('T')[0]}
    class={spacingClass}
  >
    updated {formatDate(updatedDate, format)}
  </time>
)}

<span class={spacingClass}>
  {minutes} min
</span>

<style>
.post-spacing { margin-left: 0.4375rem; }
.list-spacing { margin-left: 0.375rem; }
</style>
