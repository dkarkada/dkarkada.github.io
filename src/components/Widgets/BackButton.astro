---
import GoBackIcon from '@/assets/icons/go-back.svg';
---

<a
  id="back-button"
  href="/"
  aria-label="Go back to home"
>
  <GoBackIcon aria-hidden="true" fill="currentColor" />
</a>

<a id="back-home-mobile" href="/">&larr; back to home</a>

<style>
#back-button {
  display: none;
}

/* mobile-only text equivalent, sits above the post title */
#back-home-mobile {
  display: block;
  width: fit-content;
  margin-bottom: 0.75rem;
  font-weight: 400;
  text-decoration-line: none;
  font-size: 0.8rem;
  font-family: var(--font-navbar);
  font-style: italic;
  color: oklch(var(--color-secondary-params) / 0.5);
}
@media (min-width: 1024px) {
  #back-home-mobile { display: none; }
  #back-button {
    display: block;
    position: absolute;
    left: -2.5rem;
    top: 0.95rem;
    aspect-ratio: 1 / 1;
    width: 1.125rem;
    color: oklch(var(--color-secondary-params) / 0.4);
    transition-property: color;
    transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
    transition-duration: 150ms;
    cursor: pointer;
  }
  #back-button:hover {
    color: oklch(var(--color-secondary-params) / 0.8);
  }
  #back-button:active {
    transform: scale(0.9) !important;
  }
}
</style>
