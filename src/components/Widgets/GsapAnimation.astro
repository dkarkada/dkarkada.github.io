<script>
function animateIn(els: Element[], baseDelay: number, stagger: number = 0) {
  els.forEach((el, i) => {
    const d = (baseDelay + i * stagger).toFixed(3)
    ;(el as HTMLElement).style.transition = `opacity 0.5s ease-out ${d}s, transform 0.5s ease-out ${d}s`
  })
  // Force reflow so initial CSS state (opacity:0, transform) is applied before transitioning
  document.body.getBoundingClientRect()
  els.forEach((el) => {
    ;(el as HTMLElement).style.opacity = '1'
    ;(el as HTMLElement).style.transform = 'none'
  })
}

function setupPostPageAnimation() {
  if (document.documentElement.classList.contains('reduce-motion')) return

  const postContent = document.getElementById('gsap-post-content')
  if (!postContent) return

  const postContentChildren = Array.from(postContent.children)
  const tagsElement = document.getElementById('gsap-post-tags')
  const giscusElement = document.getElementById('giscus')
  const walineElement = document.getElementById('waline')
  const allElements = [...postContentChildren, tagsElement, giscusElement, walineElement].filter(Boolean) as Element[]

  const tocContainer = document.getElementById('toc-container')
  const tocIcon = document.getElementById('toc-desktop-icon')
  const tocList = document.getElementById('toc-links-list')
  const tocListChildren = tocList ? Array.from(tocList.children) : []
  const backButton = document.getElementById('back-button')
  const postDate = document.getElementById('gsap-post-date')

  const isLargeScreen = window.matchMedia('(min-width: 1024px)').matches
  const isSmallScreen = window.matchMedia('(max-width: 1535px)').matches

  if (isLargeScreen) {
    animateIn(allElements.slice(0, 14), 0.2, 0.05)
    if (allElements.length > 14) animateIn(allElements.slice(14), 0.2 + 0.05 * 14)
    if (postDate) animateIn([postDate], 0.15)
    if (tocIcon) animateIn([tocIcon], 0.25)
    if (tocListChildren.length > 0) animateIn(tocListChildren, 0.25, 0.025)
    if (backButton) animateIn([backButton], 0.2)
  }
  else {
    animateIn(postContentChildren.slice(0, 7), 0.2, 0.05)
  }

  if (isSmallScreen && tocContainer) animateIn([tocContainer], 0.15)
}

setupPostPageAnimation()
document.addEventListener('astro:after-swap', setupPostPageAnimation)
</script>
