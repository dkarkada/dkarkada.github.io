---
interface Props {
  tags: string[]
  currentTag?: string
}

const { tags, currentTag = '' } = Astro.props;
---

<div class="tags-wrapper">
  {tags.map(tag => (
    <a
      href={`/tags/${tag}/`}
      class:list={['tag-link', { 'tag-active': currentTag === tag }]}
    >
      <span class="tag-label">{tag}</span>
      <span class="tag-sizer" aria-hidden="true">{tag}</span>
    </a>
  ))}
</div>

<style>
.tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  column-gap: 0.75rem;
  row-gap: 0.8rem;
}

.tag-link {
  position: relative;
  display: inline-block;
  border-width: 1px;
  border-style: solid;
  border-color: oklch(var(--color-secondary-params) / 0.25);
  border-radius: 9999px;
  padding: 0.175rem 0.8rem;
  box-shadow: none;
  transition-property: color, background-color, border-color, box-shadow;
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
  transition-duration: 150ms;
}
.tag-link:hover,
.tag-link.tag-active {
  border-color: oklch(var(--color-secondary-params) / 0.8);
  color: var(--color-primary);
  font-weight: 500;
  box-shadow: 0 0 0 1px oklch(var(--color-secondary-params) / 0.8);
}

/* Sizer trick: invisible bold text reserves space so layout doesn't shift on hover */
.tag-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition-property: font-weight;
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
  transition-duration: 150ms;
}
.tag-sizer {
  display: inline-block;
  font-weight: 500;
  opacity: 0;
}
</style>
